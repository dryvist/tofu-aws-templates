# Shared OpenTofu/Terraform devshell (tofu, tflint, terraform-docs, aws-cli, pre-commit).
use flake "github:dryvist/nix-devenv?dir=shells/terraform"

# This module is validated with OpenTofu (matching the consuming fleet). Point
# pre-commit-terraform hooks at tofu instead of the HashiCorp terraform binary.
export PCT_TFPATH=tofu
